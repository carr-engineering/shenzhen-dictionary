# Model binaries over 1 MB are restored by tools/fetch_models.sh (./gradlew :recognition:fetchModels).
src/androidMain/assets/models/ink/*.tflite
# The TFLite Web runtime of the browser build, restored by the same script.
web-runtime/
# ONNX Runtime Web, restored by tools/fetch_ort_web.sh.
web-ort-runtime/
build/
# The TensorFlow Lite C runtime of the iOS build, restored by tools/fetch_ios_frameworks.sh.
ios-frameworks/

# The OCR models of the Android and iOS apps, restored by tools/fetch_ocr2_models.sh (./gradlew :recognition:fetchOcr2Models).
src/androidMain/assets/models/ocr2/
